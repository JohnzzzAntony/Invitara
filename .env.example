PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATA_DIR=./data
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BUSINESS_NAME=Invitara
SUPPORT_EMAIL=
# Only set when deployed behind exactly one trusted reverse proxy:
TRUST_PROXY_HOPS=

# NVIDIA API Catalog key (build.nvidia.com) enables the editor AI assistant:
NVIDIA_API_KEY=

# Optional: WhatsApp number for the contact page, in international format (e.g. 971501234567)
SUPPORT_WHATSAPP=
# Optional: enables Plausible analytics for this domain (e.g. respondr.shop)
PLAUSIBLE_DOMAIN=
